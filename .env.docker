# ==============================================================================
# Erlass Institute — Docker Production Environment
# ==============================================================================
# Copy this file to .env and fill in the actual values before deploying.
# JANGAN commit file .env ke Git!
# ==============================================================================

# Application
APP_NAME="Erlass Institute"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://erlass.institute

# Database Configuration (WAJIB DIUBAH!)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erlass_production
DB_USERNAME=erlass_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_JUGA

# Redis Configuration (WAJIB DIUBAH!)
REDIS_HOST=redis
REDIS_PASSWORD=GANTI_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0

# Cache & Session
CACHE_STORE=redis
CACHE_PREFIX=erlass_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=erlass.institute

# Queue (untuk kirim WhatsApp & Email async)
QUEUE_CONNECTION=redis

# Mail Configuration
# Sesuaikan dengan provider email Anda.
# Panduan lengkap: docs/ops/MAIL_SETUP.md
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@erlass.institute
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@erlass.institute
MAIL_FROM_NAME="Erlass Institute"

# File Storage
FILESYSTEM_DISK=public

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Monitoring (Opsional)
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.2

# WhatsApp Configuration (Fonnte)
WHATSAPP_PROVIDER=fonnte
WHATSAPP_FONNTE_TOKEN=your_fonnte_token_here

# Security
SANCTUM_STATEFUL_DOMAINS=erlass.institute
BCRYPT_ROUNDS=12
