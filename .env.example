# Application
APP_NAME="Web Apperlass"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://webapperlass.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webapperlass
DB_USERNAME=webapperlass_user
DB_PASSWORD=secure_password_here
DB_ROOT_PASSWORD=secure_root_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=secure_redis_password_here
REDIS_PORT=6379
REDIS_DB=0

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=webapperlass_cache

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue Configuration
QUEUE_CONNECTION=redis

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@webapperlass.com
MAIL_FROM_NAME="Web Apperlass"

# File Storage
FILESYSTEM_DISK=public

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# AWS S3 (Optional for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=webapperlass-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Monitoring (Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
TELESCOPE_ENABLED=false

# WhatsApp Gateway (Fonnte)
WHATSAPP_PROVIDER=log
WHATSAPP_FONNTE_TOKEN=
WHATSAPP_WELCOME_ENABLED=false

# Security
SANCTUM_STATEFUL_DOMAINS=webapperlass.com,localhost
BCRYPT_ROUNDS=12

# Default Seeder Passwords (CHANGE IN PRODUCTION)
WEBMASTER_PASSWORD=W3bm4st3r_S3cur3_P4ss!
ADMIN_PASSWORD=Adm1n_S3cur3_P4ss!
INSTRUCTOR_PASSWORD=Instr_S3cur3_P4ss!
PENDING_PASSWORD=P3nd1ng_S3cur3_P4ss!